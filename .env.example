# Bifrost Gateway URL & Virtual Key
BIFROST_BASE_URL=http://localhost:8080/openai/v1
BIFROST_VIRTUAL_KEY=sk-bf-your-key

# Model Routing & Failover
PRIMARY_MODEL=openai/gpt-4o-mini
FALLBACK_MODELS=anthropic/claude-3-5-sonnet-20241022,ollama/qwen2.5-coder:7b
LOCAL_CONFIDENTIAL_MODEL=ollama/qwen2.5-coder:7b

# Pre-call Budget Cap (USD)
USER_BUDGET_USD=0.25

# Workspace Configuration
CONFIDENTIAL_REPO=false
WORKSPACE_ROOT=.
